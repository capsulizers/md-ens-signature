{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "build-wasm": "deno run --allow-run --allow-read scripts/build-wasm.ts",
    "import-check": "deno run -A @cunarist/deno-import-check src/mod.ts tests/wasm.test.ts",
    "lit-check": "deno run -A @cunarist/deno-lit-analyzer",
    "test": "deno test --allow-read tests"
  },
  "litAnalyzer": {
    "strict": true,
    "rules": {
      "no-unknown-tag-name": "error"
    }
  },
  "exclude": [
    ".vite",
    "dist",
    "src/wasm-pkg"
  ],
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "vite/client"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "plugins": [
      "./scripts/deno-lint-plugin.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ],
      "include": [
        "eqeqeq",
        "camelcase",
        "guard-for-in",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-external-import",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-throw-literal",
        "prefer-ascii",
        "verbatim-module-syntax"
      ]
    }
  },
  "imports": {
    "#components": "./src/components/mod.ts",
    "#context": "./src/context/mod.ts",
    "#constants": "./src/constants/mod.ts",
    "#wasm-pkg": "./src/wasm-pkg/md_ens_signature_wasm.js",
    "@cunarist/deno-import-check": "jsr:@cunarist/deno-import-check@0.9.0",
    "@cunarist/deno-lit-analyzer": "jsr:@cunarist/deno-lit-analyzer@0.4.3",
    "@cunarist/deno-lint-plugin-explicit-types": "jsr:@cunarist/deno-lint-plugin-explicit-types@0.5.1",
    "@cunarist/deno-lint-plugin-lit": "jsr:@cunarist/deno-lint-plugin-lit@0.7.0",
    "@hugoalh/deno-lint-rules": "jsr:@hugoalh/deno-lint-rules@0.18.2",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "typescript": "npm:typescript@5.9.2",
    "vite": "npm:vite@^7.1.3",
    "lit": "npm:lit@^3.2.0",
    "@lit/context": "npm:@lit/context@^1.1.0",
    "@awesome.me/webawesome": "npm:@awesome.me/webawesome@^3.5.0",
    "bootstrap-icons": "npm:bootstrap-icons@^1.13.1"
  }
}
